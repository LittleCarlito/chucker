; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chuck"
run/main_scene="res://scenes/SalinasFlats.tscn"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://resources/icon.svg"

[autoload]

DrawUtil="*res://utils/draw_util.gd"
NodeUtil="*res://utils/node_util.gd"
Logger="*res://utils/logger.gd"
InputEventLibrary="*res://configuration/input/input_event_library.gd"
InputSprite="*res://configuration/sprite/input_sprite.gd"
SceneLibrary="*res://configuration/scenes/scene_library.gd"
GlobalSettings="*res://configuration/global_settings.gd"

[improved_json]

config/json_object_config_registry="res://utils/JSONObjectConfigRegistry.tres"

