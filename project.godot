; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chuck"
run/main_scene="res://scenes/SalinasFlats.tscn"
config/use_custom_user_dir=true
config/project_settings_override="user://settings/override.cfg"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://resources/icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

DrawUtil="*res://utils/draw_util.gd"
NodeUtil="*res://utils/node_util.gd"
Logger="*res://utils/logger.gd"
InputSprite="*res://configuration/input/input_sprite.gd"
GlobalHoleData="*res://assets/buildings/course/data/global_hole_data.gd"
UserSettingData="*res://configuration/handler/user_setting_data.gd"
AssetDelivery="*res://assets/factory/asset_delivery.gd"
GlobalInputController="*res://input/global_input_controller.gd"
GlobalCameraController="*res://assets/camera/global_camera_controller.gd"
GlobalCursorController="*res://input/global_cursor_controller.gd"
GlobalStateController="*res://state/global_state_controller.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/size/borderless=true
window/stretch/mode="canvas_items"
window/stretch/scale=1.3

[global_group]

Disk="Disks of all types"
General="General global group"
Level="Scenes serving as levels"
Player="Playable characters"
TeeBox="Nodes serving as hole starting locations"
Course="Hole nodes that compose the course"
Hole="Objects that mark the end of a hole"
CameraContainer="Contains all CameraContainer nodes"
ConfigHandler="Handles config files and values"

