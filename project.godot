[layer_names]

3d_render/layer_11="PlayerMenu"
3d_physics/layer_1="Player"
3d_physics/layer_2="Environment"
3d_physics/layer_3="Disk"
3d_physics/layer_4="Hole"
3d_physics/layer_5="Teebox"
3d_physics/layer_6="CollisionBox"

[physics]

3d/physics_engine="JoltPhysics3D"
jolt_3d/collisions/areas_detect_static_bodies=true

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
